/* tests/stdlib/ipc.czet — <utils/ipc.h>: AF_UNIX server/client with fork. */
#define _POSIX_C_SOURCE 200809L
#include <stdio.h>
#include <string.h>
#include <sys/wait.h>
#include <time.h>
#include <unistd.h>
#include <utils/ipc.h>

static void msleep(long ms)
{
    struct timespec ts;
    ts.tv_sec = ms / 1000;
    ts.tv_nsec = (ms % 1000) * 1000000L;
    nanosleep(&ts, (struct timespec *)0);
}

int main(void)
{
    const char *path = "/tmp/czet_ipc_test.sock";
    pid_t pid = fork();
    if (pid < 0)
    {
        printf("[FAIL] ipc fork\n");
        return 1;
    }
    if (pid == 0)
    {
        int fd = -1, i;
        char back[2];
        for (i = 0; i < 100 && ipc_client_open(path, &fd) != 0; i++)
            msleep(10);
        if (fd < 0)
            return 1;
        if (ipc_send_all(fd, "helo", 4) != 0)
            return 1;
        if (ipc_recv_all(fd, back, 2) != 0)
            return 1;
        ipc_client_close(&fd);
        return (back[0] == 'o' && back[1] == 'k') ? 0 : 1;
    }
    {
        int srv = -1, cli = -1, st = 0, ok;
        char buf[4];
        if (ipc_server_open(path, &srv, &cli) != 0)
        {
            printf("[FAIL] ipc server_open\n");
            return 1;
        }
        if (ipc_recv_all(cli, buf, 4) != 0)
            return 1;
        if (ipc_send_all(cli, "ok", 2) != 0)
            return 1;
        ipc_server_close(path, &srv, &cli);
        waitpid(pid, &st, 0);
        ok = (WIFEXITED(st) && WEXITSTATUS(st) == 0
              && memcmp(buf, "helo", 4) == 0 && srv == -1 && cli == -1);
        printf(ok ? "[OK] ipc\n" : "[FAIL] ipc\n");
        return ok ? 0 : 1;
    }
}
