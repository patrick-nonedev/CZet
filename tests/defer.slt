#include <stdio.h>
#include <stdlib.h>

char* test()
{
    size_t capacity = 16;
    char *buffer = malloc( capacity * sizeof(char) );
    defer
    {
        free(buffer);
        buffer = NULL;
        printf("buffer is freed (idk how to write it)\n");
        return buffer;
    };

    /* usage of the buffer */
    for (size_t i = 0; i < capacity; ++i)
    {
        buffer[i] = i * 2;
    }

    /* now it frees correctly */
}

int main()
{
    if (test() == NULL)
        printf("All test passed\n");

    return 0;
}
