/* Tree nodes used in the C frontend only, not shared with C++ frontend.  */

/* Used to represent a vector of tokens for deferred parsing.  */
DEFTREECODE (C_TOKEN_VEC, "c_token_vec", tcc_exceptional, 0)

/* Placeholder type for a czet generic type parameter (T, U, W ...).
   The parameter NAME (an IDENTIFIER_NODE) lives in TYPE_NAME.  It is
   substituted for a concrete type at instantiation time (monomorphization).  */
DEFTREECODE (CZET_TPL_TYPE, "czet_tpl_type", tcc_type, 0)

/* These codes are used by C++ but referenced from always-compiled GCC
   back-end/helper sources (fold-const.cc, c/c-decl.cc, c-family/c-gimplify.cc,
   tree.cc).  Since the C++ front end is not built, they are defined here so
   those references keep compiling.  */
DEFTREECODE (EXPR_STMT, "expr_stmt", tcc_expression, 1)

/* The C++ alignof, referenced from the shared OMP mappers walker.  */
DEFTREECODE (ALIGNOF_EXPR, "alignof_expr", tcc_expression, 1)

/* Referenced from the always-compiled tree.cc verify_type walker.  */
DEFTREECODE (TEMPLATE_DECL, "template_decl", tcc_declaration, 0)
DEFTREECODE (USING_DECL, "using_decl", tcc_declaration, 0)

/* Referenced from the always-compiled c-family/c-attribs.cc (malloc attr).  */
DEFTREECODE (OVERLOAD, "overload", tcc_exceptional, 0)

/*
Local variables:
mode:c
End:
*/
